<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>CoolhandLabs.Extensions.Http</RootNamespace>
    <PackageId>CoolhandLabs.Coolhand.Extensions.Http</PackageId>
    <Description>IHttpClientFactory integration for Coolhand: one AddCoolhand() call monitors the LLM API calls of every HttpClient the factory creates.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <ProjectReference Include="../CoolhandLabs.Coolhand/CoolhandLabs.Coolhand.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
