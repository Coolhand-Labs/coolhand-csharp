<Project>
  <!-- The SDK version lives here once. It drives the package version, the collector string
       (coolhand-csharp-<version>-<method>) and the User-Agent (coolhand-csharp/<version>). -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Authors>Coolhand Labs</Authors>
    <Company>Coolhand Labs</Company>
    <Copyright>Copyright Coolhand Labs</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://coolhandlabs.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Coolhand-Labs/coolhand-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>llm;openai;anthropic;monitoring;observability;logging;coolhand</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
</Project>
